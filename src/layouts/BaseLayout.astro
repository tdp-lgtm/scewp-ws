---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/utils";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  rawTitle?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, rawTitle, jsonLd } = Astro.props;
const adminUrl = withBase("/admin/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      rawTitle={rawTitle}
      jsonLd={jsonLd}
    />
    {/*
      Netlify Identity widget — handles invite/recovery tokens that land on the
      site root (e.g. #invite_token=…) by opening the "set password" dialog, and
      redirects to the CMS after login. Dormant when no Identity instance exists
      (e.g. on GitHub Pages), so it is harmless there.
    */}
    <script
      is:inline
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline define:vars={{ adminUrl }}>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = adminUrl;
            });
          }
        });
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
