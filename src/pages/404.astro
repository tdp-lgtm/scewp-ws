---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/utils";
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="container-page flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-heading text-7xl font-black text-secondary">404</p>
    <h1 class="mt-4">Page not found</h1>
    <p class="mt-3 max-w-md text-muted">
      The page you were looking for doesn't exist or may have moved. Let's get
      you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={withBase("/")} class="btn btn-ghost">Back to home</a>
      <a href={withBase("/research")} class="btn btn-ghost">Our research</a>
    </div>
  </section>
</BaseLayout>
