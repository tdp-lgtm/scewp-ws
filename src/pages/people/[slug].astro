---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BackLink from "../../components/BackLink.astro";
import TagBadge from "../../components/TagBadge.astro";
import PublicationEntry from "../../components/PublicationEntry.astro";
import ExternalLinkIcon from "../../components/ExternalLinkIcon.astro";
import { nameMatchesAuthor, withBase } from "../../lib/utils";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"people">;
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await entry.render();

// Find this person's publications by simple surname match.
const allPubs = await getCollection("publications");
const theirPubs = allPubs
  .filter((pub) => pub.data.authors.some((a) => nameMatchesAuthor(p.name, a)))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title={p.name} description={p.bio}>
  <PageHero
    title={p.name}
    subtitle={p.role}
    breadcrumb={[
      { label: "Home", href: "/" },
      { label: "People", href: "/people" },
      { label: p.name },
    ]}
  />

  <div class="container-page py-16">
    <BackLink href="/people" label="Back to all people" />

    <div class="mt-8 grid gap-12 lg:grid-cols-3">
      <aside class="lg:col-span-1">
        {
          p.photo ? (
            <img
              src={withBase(p.photo)}
              alt={`Portrait of ${p.name}`}
              class="w-full max-w-xs rounded-lg object-cover"
            />
          ) : (
            <div
              class="flex aspect-square w-full max-w-xs items-center justify-center rounded-lg bg-primary/10 font-heading text-6xl text-primary"
              aria-hidden="true"
            >
              {p.name.charAt(0)}
            </div>
          )
        }

        <dl class="mt-6 space-y-3 text-sm">
          <div>
            <dt class="font-semibold text-primary">Role</dt>
            <dd class="text-muted">{p.role}</dd>
          </div>
          {
            p.email && (
              <div>
                <dt class="font-semibold text-primary">Email</dt>
                <dd>
                  <a
                    href={`mailto:${p.email}`}
                    class="text-accent no-underline hover:underline"
                  >
                    {p.email}
                  </a>
                </dd>
              </div>
            )
          }
          {
            p.website && (
              <div>
                <dt class="font-semibold text-primary">Website</dt>
                <dd>
                  <a
                    href={p.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-accent no-underline hover:underline"
                  >
                    Personal page <ExternalLinkIcon />
                  </a>
                </dd>
              </div>
            )
          }
          {
            p.publications_link && (
              <div>
                <dt class="font-semibold text-primary">Publications</dt>
                <dd>
                  <a
                    href={p.publications_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-accent no-underline hover:underline"
                  >
                    PhilPapers profile <ExternalLinkIcon />
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="lg:col-span-2">
        <div class="prose-academic">
          <p class="text-lg">{p.bio}</p>
          <Content />
        </div>

        {
          p.research_interests && p.research_interests.length > 0 && (
            <div class="mt-8">
              <h2 class="text-xl">Research interests</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.research_interests.map((ri) => (
                  <TagBadge label={ri} variant="gold" />
                ))}
              </div>
            </div>
          )
        }

        {
          theirPubs.length > 0 && (
            <div class="mt-12">
              <h2 class="text-xl">Selected publications</h2>
              <div class="mt-3">
                {theirPubs.map((pub) => (
                  <PublicationEntry entry={pub} />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
