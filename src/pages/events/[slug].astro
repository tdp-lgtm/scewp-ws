---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BackLink from "../../components/BackLink.astro";
import ExternalLinkIcon from "../../components/ExternalLinkIcon.astro";
import { formatDate, isUpcoming } from "../../lib/utils";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"events">;
}

const { entry } = Astro.props;
const e = entry.data;
const { Content } = await entry.render();
const upcoming = isUpcoming(e.start_date);
const dateLabel = e.end_date
  ? `${formatDate(e.start_date)} – ${formatDate(e.end_date)}`
  : formatDate(e.start_date);

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: e.title,
  startDate: e.start_date.toISOString(),
  ...(e.end_date ? { endDate: e.end_date.toISOString() } : {}),
  eventAttendanceMode: e.online
    ? "https://schema.org/OnlineEventAttendanceMode"
    : "https://schema.org/OfflineEventAttendanceMode",
  ...(e.location ? { location: { "@type": "Place", name: e.location } } : {}),
  organizer: {
    "@type": "Organization",
    name: "Stockholm Centre for the Ethics of War and Peace",
  },
};
---

<BaseLayout
  title={e.title}
  description={`${e.event_type} · ${dateLabel}`}
  jsonLd={eventJsonLd}
>
  <PageHero
    title={e.title}
    subtitle={dateLabel}
    breadcrumb={[
      { label: "Home", href: "/" },
      { label: "Events", href: "/events" },
      { label: e.title },
    ]}
  />

  <div class="container-page py-16">
    <BackLink href="/events" label="Back to events" />

    <div class="mt-8 grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary"
            >{e.event_type}</span
          >
          {
            e.online && (
              <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800">
                Online
              </span>
            )
          }
          <span
            class:list={[
              "rounded-full px-3 py-1 text-xs font-medium",
              upcoming
                ? "bg-secondary/20 text-primary"
                : "bg-black/5 text-muted",
            ]}>{upcoming ? "Upcoming" : "Past"}</span
          >
        </div>

        <div class="prose-academic mt-6">
          <Content />
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          {
            upcoming && e.registration_url && (
              <a
                href={e.registration_url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost inline-flex items-center gap-2"
              >
                Register <ExternalLinkIcon class="h-4 w-4" />
              </a>
            )
          }
          {
            upcoming && e.online && e.online_link && (
              <a
                href={e.online_link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost inline-flex items-center gap-2"
              >
                Join online <ExternalLinkIcon class="h-4 w-4" />
              </a>
            )
          }
          {
            !upcoming && e.recording_url && (
              <a
                href={e.recording_url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost inline-flex items-center gap-2"
              >
                Watch recording <ExternalLinkIcon class="h-4 w-4" />
              </a>
            )
          }
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="rounded-lg border border-border bg-white p-6 text-sm">
          <dl class="space-y-4">
            <div>
              <dt class="font-semibold text-primary">Date</dt>
              <dd class="text-muted">{dateLabel}</dd>
            </div>
            {
              e.time && (
                <div>
                  <dt class="font-semibold text-primary">Time</dt>
                  <dd class="text-muted">{e.time}</dd>
                </div>
              )
            }
            {
              e.location && (
                <div>
                  <dt class="font-semibold text-primary">Location</dt>
                  <dd class="text-muted">{e.location}</dd>
                </div>
              )
            }
            {
              e.speakers && e.speakers.length > 0 && (
                <div>
                  <dt class="font-semibold text-primary">Speakers</dt>
                  <dd class="text-muted">
                    <ul class="mt-1 space-y-1">
                      {e.speakers.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
