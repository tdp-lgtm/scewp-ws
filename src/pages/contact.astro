---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/utils";
---

<BaseLayout
  title="Contact"
  description="Contact the Stockholm Centre for the Ethics of War and Peace."
>
  <PageHero
    title="Contact"
    subtitle="We'd be glad to hear from you"
    breadcrumb={[{ label: "Home", href: "/" }, { label: "Contact" }]}
  />

  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-5">
      {/* Contact form (Netlify Forms — no backend required) */}
      <div class="lg:col-span-3">
        <h2 class="text-2xl">Send us a message</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={withBase("/contact?sent=true")}
          class="mt-6 space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Don't fill this out if you're human:
              <input name="bot-field" />
            </label>
          </p>

          <div>
            <label for="name" class="block text-sm font-medium text-text"
              >Name</label
            >
            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-1.5 w-full rounded-md border border-border bg-white px-4 py-2.5 focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text"
              >Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-1.5 w-full rounded-md border border-border bg-white px-4 py-2.5 focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-text"
              >Subject</label
            >
            <select
              id="subject"
              name="subject"
              class="mt-1.5 w-full rounded-md border border-border bg-white px-4 py-2.5 focus:border-primary focus:outline-none"
            >
              <option>General</option>
              <option>Media</option>
              <option>Research Collaboration</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="mt-1.5 w-full rounded-md border border-border bg-white px-4 py-2.5 focus:border-primary focus:outline-none"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-ghost">Send message</button>
        </form>
      </div>

      {/* Contact details */}
      <aside class="lg:col-span-2">
        <div class="rounded-lg border border-border bg-white p-6">
          <h2 class="text-2xl">Find us</h2>
          <address class="mt-4 not-italic leading-relaxed text-text/80">
            Stockholm Centre for the Ethics of War and Peace<br />
            Department of Philosophy<br />
            Stockholm University<br />
            SE-106 91 Stockholm<br />
            Sweden
          </address>

          <p class="mt-6 text-sm">
            <span class="font-medium">Email:</span>{" "}
            <a
              href="mailto:info@stockholmcentre.org"
              class="text-accent no-underline hover:underline"
              >info@stockholmcentre.org</a
            >
          </p>
          <p class="mt-2 text-sm">
            <span class="font-medium">Twitter / X:</span>{" "}
            <a
              href="https://twitter.com/EthicsWarPeace"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent no-underline hover:underline">@EthicsWarPeace</a
            >
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
