---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import BackLink from "../../../components/BackLink.astro";
import TagBadge from "../../../components/TagBadge.astro";
import ExternalLinkIcon from "../../../components/ExternalLinkIcon.astro";
import { formatAuthors } from "../../../lib/utils";

export async function getStaticPaths() {
  const pubs = await getCollection("publications");
  return pubs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"publications">;
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await entry.render();
const doiUrl = p.doi
  ? `https://doi.org/${p.doi.replace(/^https?:\/\/doi\.org\//, "")}`
  : null;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: p.title,
  author: p.authors.map((a) => ({ "@type": "Person", name: a })),
  datePublished: String(p.year),
  publisher: p.journal_or_publisher,
};
---

<BaseLayout
  title={p.title}
  description={p.abstract || `${p.title} (${p.year})`}
  jsonLd={articleJsonLd}
>
  <PageHero
    title={p.title}
    breadcrumb={[
      { label: "Home", href: "/" },
      { label: "Research", href: "/research" },
      { label: "Publications", href: "/research/publications" },
      { label: p.title },
    ]}
  />

  <div class="container-page py-16">
    <BackLink href="/research/publications" label="Back to publications" />

    <div class="mt-8 max-w-3xl">
      <p class="text-lg text-text">
        {formatAuthors(p.authors)} <span class="font-bold">({p.year})</span>
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <TagBadge label={p.publication_type} variant="navy" />
        {(p.tags || []).map((t) => <TagBadge label={t} />)}
      </div>

      <dl class="mt-6 space-y-1 text-sm text-muted">
        {
          p.journal_or_publisher && (
            <div>
              <dt class="inline font-semibold text-text">Published in: </dt>
              <dd class="inline">{p.journal_or_publisher}</dd>
            </div>
          )
        }
        {
          p.volume && (
            <div>
              <dt class="inline font-semibold text-text">Volume: </dt>
              <dd class="inline">{p.volume}</dd>
            </div>
          )
        }
        {
          p.pages && (
            <div>
              <dt class="inline font-semibold text-text">Pages: </dt>
              <dd class="inline">{p.pages}</dd>
            </div>
          )
        }
      </dl>

      {
        p.abstract && (
          <div class="mt-8">
            <h2 class="text-xl">Abstract</h2>
            <p class="mt-2 leading-relaxed text-text/85">{p.abstract}</p>
          </div>
        )
      }

      <div class="prose-academic mt-6">
        <Content />
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        {
          doiUrl && (
            <a
              href={doiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost inline-flex items-center gap-2"
            >
              View DOI <ExternalLinkIcon class="h-4 w-4" />
            </a>
          )
        }
        {
          p.open_access_url && (
            <a
              href={p.open_access_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost inline-flex items-center gap-2"
            >
              Open Access <ExternalLinkIcon class="h-4 w-4" />
            </a>
          )
        }
        {
          p.pdf_file && (
            <a
              href={p.pdf_file}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
            >
              Download PDF
            </a>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
