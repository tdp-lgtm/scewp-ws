---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import PublicationEntry from "../../../components/PublicationEntry.astro";

const pubs = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
);

// Unique years (desc), types, and tags for filter controls.
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const types = [...new Set(pubs.map((p) => p.data.publication_type))].sort();
const tags = [
  ...new Set(pubs.flatMap((p) => p.data.tags || [])),
].sort();

// Group publications by year for display.
const grouped = years.map((year) => ({
  year,
  items: pubs.filter((p) => p.data.year === year),
}));
---

<BaseLayout
  title="Publications"
  description="Books, articles, and chapters by members of the Stockholm Centre for the Ethics of War and Peace."
>
  <PageHero
    title="Publications"
    subtitle="Books, articles, chapters, and working papers"
    breadcrumb={[
      { label: "Home", href: "/" },
      { label: "Research", href: "/research" },
      { label: "Publications" },
    ]}
  />

  <div class="container-page py-16">
    {/* Filter controls */}
    <div class="rounded-lg border border-border bg-white p-6">
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label
            for="filter-year"
            class="block text-xs font-semibold uppercase tracking-wide text-muted"
            >Year</label
          >
          <select
            id="filter-year"
            class="mt-2 w-full rounded-md border border-border bg-white px-3 py-2 text-sm focus:border-primary focus:outline-none"
          >
            <option value="">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>

        <div>
          <span
            class="block text-xs font-semibold uppercase tracking-wide text-muted"
            >Type</span
          >
          <div class="mt-2 flex flex-wrap gap-2">
            <button
              data-type-filter=""
              aria-pressed="true"
              class="type-tab rounded-full border border-border px-3 py-1 text-xs font-medium aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
              >All</button
            >
            {
              types.map((t) => (
                <button
                  data-type-filter={t}
                  aria-pressed="false"
                  class="type-tab rounded-full border border-border px-3 py-1 text-xs font-medium aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
                >
                  {t}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      {
        tags.length > 0 && (
          <div class="mt-6">
            <span class="block text-xs font-semibold uppercase tracking-wide text-muted">
              Topics
            </span>
            <div class="mt-2 flex flex-wrap gap-2">
              {tags.map((t) => (
                <button
                  data-tag-filter={t}
                  aria-pressed="false"
                  class="tag-tab rounded-full border border-border px-3 py-1 text-xs font-medium aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white"
                >
                  {t}
                </button>
              ))}
            </div>
          </div>
        )
      }
    </div>

    {/* Result count */}
    <p class="mt-6 text-sm text-muted">
      Showing <span id="result-count" class="font-semibold text-text"
        >{pubs.length}</span
      > of {pubs.length} publications
    </p>

    {/* Publication list grouped by year */}
    <div id="pub-list" class="mt-4">
      {
        grouped.map((group) => (
          <section class="year-group" data-year={group.year}>
            <h2 class="mt-10 border-b-2 border-secondary/40 pb-1 text-2xl">
              {group.year}
            </h2>
            <div>
              {group.items.map((entry) => (
                <PublicationEntry entry={entry} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <p id="pub-empty" class="hidden py-12 text-center text-muted">
      No publications match the selected filters.
    </p>
  </div>
</BaseLayout>

<script>
  const yearSelect = document.getElementById(
    "filter-year",
  ) as HTMLSelectElement | null;
  const typeTabs = document.querySelectorAll<HTMLButtonElement>(".type-tab");
  const tagTabs = document.querySelectorAll<HTMLButtonElement>(".tag-tab");
  const entries =
    document.querySelectorAll<HTMLElement>(".publication-entry");
  const groups = document.querySelectorAll<HTMLElement>(".year-group");
  const countEl = document.getElementById("result-count");
  const emptyEl = document.getElementById("pub-empty");

  const state = {
    year: "",
    type: "",
    tags: new Set<string>(),
  };

  function apply() {
    let visible = 0;
    entries.forEach((el) => {
      const year = el.dataset.year || "";
      const type = el.dataset.type || "";
      const tags = (el.dataset.tags || "").split(",").filter(Boolean);

      const matchYear = !state.year || year === state.year;
      const matchType = !state.type || type === state.type;
      const matchTags =
        state.tags.size === 0 ||
        [...state.tags].every((t) => tags.includes(t));

      const show = matchYear && matchType && matchTags;
      el.style.display = show ? "" : "none";
      if (show) visible++;
    });

    // Hide year-group headers with no visible entries.
    groups.forEach((group) => {
      const anyVisible = group.querySelector<HTMLElement>(
        '.publication-entry:not([style*="display: none"])',
      );
      group.style.display = anyVisible ? "" : "none";
    });

    if (countEl) countEl.textContent = String(visible);
    emptyEl?.classList.toggle("hidden", visible > 0);
  }

  yearSelect?.addEventListener("change", () => {
    state.year = yearSelect.value;
    apply();
  });

  typeTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      typeTabs.forEach((t) => t.setAttribute("aria-pressed", "false"));
      tab.setAttribute("aria-pressed", "true");
      state.type = tab.dataset.typeFilter || "";
      apply();
    });
  });

  tagTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const tag = tab.dataset.tagFilter!;
      if (state.tags.has(tag)) {
        state.tags.delete(tag);
        tab.setAttribute("aria-pressed", "false");
      } else {
        state.tags.add(tag);
        tab.setAttribute("aria-pressed", "true");
      }
      apply();
    });
  });
</script>
