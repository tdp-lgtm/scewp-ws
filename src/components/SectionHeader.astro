---
interface Props {
  title: string;
  description?: string;
  link?: string;
  linkLabel?: string;
}

const { title, description, link, linkLabel = "View all" } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div class="max-w-2xl">
    <h2 class="text-3xl">{title}</h2>
    {description && <p class="mt-2 text-muted">{description}</p>}
  </div>
  {
    link && (
      <a
        href={link}
        class="shrink-0 text-sm font-semibold text-accent no-underline hover:underline"
      >
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
