---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/utils";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const p = entry.data;
const years = p.end_year ? `${p.start_year}–${p.end_year}` : `${p.start_year}–present`;
const isCurrent = p.status === "current";
---

<article
  data-status={p.status}
  class="flex flex-col rounded-lg border border-border bg-white p-6 shadow-card transition-shadow hover:shadow-card-hover"
>
  <div class="flex items-center justify-between gap-3">
    <span
      class:list={[
        "rounded-full px-2.5 py-0.5 text-xs font-medium",
        isCurrent
          ? "bg-secondary/20 text-primary"
          : "bg-black/5 text-muted",
      ]}>{isCurrent ? "Current" : "Completed"}</span
    >
    <span class="text-xs text-muted">{years}</span>
  </div>

  <h3 class="mt-3 text-xl leading-snug">
    <a href={withBase(`/research/projects/${entry.slug}`)} class="no-underline hover:text-accent"
      >{p.title}</a
    >
  </h3>

  {
    p.lead_researcher && (
      <p class="mt-2 text-sm text-muted">
        Led by <span class="text-text">{p.lead_researcher}</span>
      </p>
    )
  }
  {p.funder && <p class="mt-1 text-xs text-muted">Funded by {p.funder}</p>}

  <a
    href={withBase(`/research/projects/${entry.slug}`)}
    class="mt-4 text-sm font-semibold text-accent no-underline hover:underline"
    >Project details →</a
  >
</article>
