---
import type { CollectionEntry } from "astro:content";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";

interface Props {
  entry: CollectionEntry<"symposia">;
}

const { entry } = Astro.props;
const s = entry.data;
---

<article
  class="flex flex-col rounded-lg border border-border bg-white p-6 shadow-card transition-shadow hover:shadow-card-hover"
>
  <p class="kicker">{s.journal} · {s.year}</p>

  <h3 class="mt-2 text-xl leading-snug">
    <a href={`/symposia/${entry.slug}`} class="no-underline hover:text-accent"
      >{s.title}</a
    >
  </h3>

  {
    s.book_title && (
      <p class="mt-2 text-sm text-muted">
        On <span class="italic">{s.book_title}</span>
        {s.book_author && <span> by {s.book_author}</span>}
      </p>
    )
  }

  <p class="mt-3 flex-1 text-sm leading-relaxed text-text/80">
    {s.subject_description}
  </p>

  {
    s.contributors && s.contributors.length > 0 && (
      <p class="mt-3 text-xs text-muted">
        <span class="font-semibold">Contributors:</span>{" "}
        {s.contributors.join(", ")}
      </p>
    )
  }

  <div class="mt-4 flex flex-wrap gap-4 text-sm">
    <a
      href={`/symposia/${entry.slug}`}
      class="font-semibold text-accent no-underline hover:underline"
      >Details →</a
    >
    {
      s.journal_url && (
        <a
          href={s.journal_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-muted no-underline hover:text-accent"
        >
          Journal <ExternalLinkIcon />
        </a>
      )
    }
  </div>
</article>
