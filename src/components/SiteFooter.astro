---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Research",
    links: [
      { label: "Current Projects", href: "/research/projects" },
      { label: "Publications", href: "/research/publications" },
      { label: "Journal Symposia", href: "/symposia" },
    ],
  },
  {
    title: "People",
    links: [
      { label: "Members", href: "/people" },
      { label: "About the Centre", href: "/about" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Events",
    links: [
      { label: "Upcoming", href: "/events#upcoming" },
      { label: "Archive", href: "/events#past" },
      { label: "News", href: "/news" },
    ],
  },
  {
    title: "Admin",
    links: [
      { label: "Editor Login", href: "/admin/" },
      { label: "Public Engagement", href: "/engagement" },
    ],
  },
];
---

<footer class="mt-24 border-t border-border bg-primary text-white/80">
  <div class="container-page py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <p class="font-heading text-xl font-bold text-white">
          Stockholm Centre for the Ethics of War &amp; Peace
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/70">
          An interdisciplinary research centre in the Department of Philosophy at
          Stockholm University, dedicated to the moral, political, and legal
          study of war and peace.
        </p>
        <div class="mt-5 flex gap-4">
          <a
            href="https://twitter.com/EthicsWarPeace"
            class="text-white/70 hover:text-secondary"
            aria-label="Twitter / X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231 5.447-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"></path>
            </svg>
          </a>
          <a
            href="https://facebook.com/"
            class="text-white/70 hover:text-secondary"
            aria-label="Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.987H7.898v-2.892h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.892h-2.33v6.987C18.343 21.128 22 16.991 22 12z"></path>
            </svg>
          </a>
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <h4 class="text-sm font-semibold uppercase tracking-kicker text-secondary">
              {col.title}
            </h4>
            <ul class="mt-4 space-y-2 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-white/70 no-underline hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Affiliation logos (placeholders) */}
    <div
      class="mt-14 flex flex-wrap items-center gap-6 border-t border-white/15 pt-8"
    >
      <div
        class="flex h-12 w-44 items-center justify-center rounded border border-white/20 text-xs text-white/50"
      >
        Stockholm University
      </div>
      <div
        class="flex h-12 w-56 items-center justify-center rounded border border-white/20 text-xs text-white/50"
      >
        Wallenberg Academy Fellows
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/15 pt-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Stockholm Centre for the Ethics of War and Peace.</p>
      <p>
        Site built with <a
          href="https://astro.build"
          class="text-white/70 hover:text-secondary"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >.
      </p>
    </div>
  </div>
</footer>
